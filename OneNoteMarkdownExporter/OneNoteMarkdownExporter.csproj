<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- RuntimeIdentifiers for publish - not set by default to allow normal build/test -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- Publish-time settings for self-contained deployment -->
  <PropertyGroup Condition="'$(PublishSingleFile)' == 'true' Or '$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="ReverseMarkdown" Version="5.3.0" />
    <PackageReference Include="System.CommandLine" Version="2.0.7" />
    <!-- Use Interop NuGet package - works on build servers and for testing -->
    <PackageReference Include="Interop.Microsoft.Office.Interop.OneNote" Version="1.1.0.2" />
  </ItemGroup>

  <!-- Copy the committed Markdown linting runtime to build and publish output. -->
  <ItemGroup>
    <None Remove="resources\**\*" />
    <None Include="resources\node.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <Link>resources\node.exe</Link>
    </None>
    <None Include="resources\markdownlint-cli2.mjs">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <Link>resources\markdownlint-cli2.mjs</Link>
    </None>
    <None Include="resources\.markdownlint.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <Link>resources\.markdownlint.json</Link>
    </None>
    <None Include="resources\THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <Link>resources\THIRD-PARTY-NOTICES.txt</Link>
    </None>
  </ItemGroup>

  <Target Name="ValidateMarkdownLintRuntime" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\resources\node.exe')" Text="Required Markdown linting runtime file is missing: resources\node.exe" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\resources\markdownlint-cli2.mjs')" Text="Required Markdown linting runtime file is missing: resources\markdownlint-cli2.mjs" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\resources\.markdownlint.json')" Text="Required Markdown linting runtime file is missing: resources\.markdownlint.json" />
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\resources\THIRD-PARTY-NOTICES.txt')" Text="Required Markdown linting runtime file is missing: resources\THIRD-PARTY-NOTICES.txt" />
  </Target>

  <Target Name="ValidatePublishedMarkdownLintRuntime" AfterTargets="Publish">
    <Error Condition="!Exists('$(PublishDir)resources\node.exe')" Text="Published Markdown linting runtime file is missing: resources\node.exe" />
    <Error Condition="!Exists('$(PublishDir)resources\markdownlint-cli2.mjs')" Text="Published Markdown linting runtime file is missing: resources\markdownlint-cli2.mjs" />
    <Error Condition="!Exists('$(PublishDir)resources\.markdownlint.json')" Text="Published Markdown linting runtime file is missing: resources\.markdownlint.json" />
    <Error Condition="!Exists('$(PublishDir)resources\THIRD-PARTY-NOTICES.txt')" Text="Published Markdown linting runtime file is missing: resources\THIRD-PARTY-NOTICES.txt" />
  </Target>

  <!-- 
    COMReference is only needed for generating new interop assemblies from locally installed OneNote.
    For normal builds and tests, we use the NuGet package above.
    To regenerate: Use Visual Studio with .NET Framework MSBuild target or msbuild.exe.
  -->
